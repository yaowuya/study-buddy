# 数据库连接
# Docker 部署时使用 host.docker.internal 访问宿主机 PostgreSQL
DATABASE_URL=postgresql://postgres:your_password@host.docker.internal:5432/studybuddy

# JWT 密钥（生产环境请使用: openssl rand -hex 32 生成）
SECRET_KEY=change-me-in-production

# Token 有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 允许跨域的前端地址，多个用 JSON 数组格式
CORS_ORIGINS=["http://localhost:5173"]

# 百度 TTS 配置（从百度智能云控制台获取）
BAIDU_TTS_API_KEY=your_api_key
BAIDU_TTS_SECRET_KEY=your_secret_key
# 默认语音：yaya(度丫丫), xiaoyao(度逍遥), xiaomei(度小美), xiaoyu(度小宇) 等
BAIDU_TTS_DEFAULT_VOICE=yaya
