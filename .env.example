# 数据库连接
# Docker 部署时使用 host.docker.internal 访问宿主机 PostgreSQL
DATABASE_URL=postgresql://postgres:your_password@host.docker.internal:5432/studybuddy

# JWT 密钥（生产环境请使用: openssl rand -hex 32 生成）
SECRET_KEY=change-me-in-production

# Token 有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 允许跨域的前端地址，多个用 JSON 数组格式
CORS_ORIGINS=["http://localhost:5173"]

# 百度 TTS 配置（从百度智能云控制台获取）
BAIDU_TTS_API_KEY=your_api_key
BAIDU_TTS_SECRET_KEY=your_secret_key
# 默认语音（可选值见下方，默认 yaya）
# 基础音库：yaya(度丫丫), xiaoyao(度逍遥), xiaomei(度小美), xiaoyu(度小宇)
# 精品音库：xiaoyao_pro(度逍遥精品), xiaolu(度小鹿), bowen(度博文), xiaotong(度小童), xiaomeng(度小萌)
# 臻品音库：xiaoyao_best(度逍遥臻品), xiaowen(度小雯), xiaoqiao(度小乔), xinghe(度星河)
# 大模型：hanzhu(度涵竹), yanran(度嫣然), zeyan(度泽言), xiaoyue(度小粤-粤语)
BAIDU_TTS_DEFAULT_VOICE=xiaoxian
